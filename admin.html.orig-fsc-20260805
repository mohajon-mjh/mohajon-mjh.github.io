<style>
*{box-sizing:border-box}
body{font-family:Arial;background:#111;color:#fff;padding:0;margin:0;overflow-x:hidden}
html{overflow-x:hidden}
.card{background:#222;padding:15px;margin:10px 0;border-radius:10px}
button{padding:8px 14px;margin:5px 5px 0 0;cursor:pointer;border:none;border-radius:6px;color:#fff;font-weight:bold}
.approve{background:green}
.reject{background:#c0392b}
.approve-seller{background:green}
.reject-seller{background:#c0392b}
.save-commission{background:#2980b9}
.add-commission{background:#2980b9}
.save-btn{background:#2980b9}
.delete-btn{background:#c0392b}
input, textarea{
  width:100%;
  padding:8px;
  margin-top:6px;
  border-radius:6px;
  border:1px solid #444;
  background:#111;
  color:#fff;
  box-sizing:border-box;
}
label{display:block;margin-top:8px;font-size:13px;color:#ccc}
h2{margin-top:0}
.section-title{
  background:#333;
  padding:10px;
  border-radius:8px;
  margin-top:25px;
}

/* ===== Admin Tab Layout ===== */
.admin-wrap{display:flex;min-height:100vh}
.admin-tabs{
  width:220px;
  background:#1a1a1a;
  padding:15px 0;
  flex-shrink:0;
  position:sticky;
  top:0;
  height:100vh;
  overflow-y:auto;
}
.notif-bell-wrap{position:fixed;top:10px;right:10px;cursor:pointer;font-size:22px;z-index:1001;background:#1a1a1a;border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.5)}
.notif-badge{position:absolute;top:-8px;right:-10px;background:#e74c3c;color:#fff;font-size:11px;font-weight:bold;border-radius:50%;min-width:18px;height:18px;display:flex;align-items:center;justify-content:center;padding:0 4px}
.notif-dropdown{display:none;position:absolute;top:45px;right:0;background:#222;border:1px solid #444;border-radius:8px;width:280px;max-height:350px;overflow-y:auto;z-index:1000;box-shadow:0 5px 20px rgba(0,0,0,.4)}
.notif-dropdown.active{display:block}
.notif-item{padding:12px;border-bottom:1px solid #333;font-size:13px;color:#eee;cursor:pointer}
.notif-item:hover{background:#2a2a2a}
.notif-empty{padding:15px;text-align:center;color:#888;font-size:13px}
.admin-tabs h2{
  font-size:16px;
  padding:0 15px 10px 15px;
  border-bottom:1px solid #333;
  margin-bottom:10px;
}
.tab-btn{
  display:block;
  width:100%;
  text-align:left;
  background:transparent;
  color:#ccc;
  padding:12px 15px;
  border-radius:0;
  margin:0;
  font-weight:normal;
  border-left:3px solid transparent;
}
.tab-btn:hover{background:#252525}
.tab-btn.active{background:#252525;color:#fff;border-left:3px solid #2980b9;font-weight:bold}
.admin-content{flex:1;padding:20px;max-width:900px}
.tab-section{display:none}
.tab-section.active{display:block}
#product-search{margin-bottom:15px;font-size:15px}
@media(max-width:700px){
  .admin-wrap{flex-direction:column}
  .admin-tabs{width:100%;height:auto;position:relative;display:flex;overflow-x:auto;padding:8px}
  .notif-bell-wrap{position:fixed;top:10px;right:10px;cursor:pointer;font-size:22px;z-index:1001;background:#1a1a1a;border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.5)}
.notif-badge{position:absolute;top:-8px;right:-10px;background:#e74c3c;color:#fff;font-size:11px;font-weight:bold;border-radius:50%;min-width:18px;height:18px;display:flex;align-items:center;justify-content:center;padding:0 4px}
.notif-dropdown{display:none;position:absolute;top:45px;right:0;background:#222;border:1px solid #444;border-radius:8px;width:280px;max-height:350px;overflow-y:auto;z-index:1000;box-shadow:0 5px 20px rgba(0,0,0,.4)}
.notif-dropdown.active{display:block}
.notif-item{padding:12px;border-bottom:1px solid #333;font-size:13px;color:#eee;cursor:pointer}
.notif-item:hover{background:#2a2a2a}
.notif-empty{padding:15px;text-align:center;color:#888;font-size:13px}
.admin-tabs h2{display:none}
  .tab-btn{width:auto;white-space:nowrap;border-left:none;border-bottom:3px solid transparent}
  .tab-btn.active{border-left:none;border-bottom:3px solid #2980b9}
}
</style>
